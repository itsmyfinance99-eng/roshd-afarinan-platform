// Roshd Afarinan platform — database schema (owned by apps/api).
// Every change requires a migration: pnpm --filter @roshd/api db:migrate:dev --name <change>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & Access ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// One identity per person; capabilities come from roles (student, applicant, investor, ...).
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  mobile       String?    @unique
  fullName     String
  passwordHash String
  status       UserStatus @default(ACTIVE)
  /// Reserved: MFA is designed but not yet implemented (ADR-0002).
  mfaEnabled   Boolean    @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  roles           UserRole[]       @relation("UserRoles")
  assignedRoles   UserRole[]       @relation("RoleAssigner")
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  serviceRequests ServiceRequest[]

  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// Stable machine key, one of ROLES in @roshd/types.
  key         String  @unique
  name        String
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// `resource:action`, one of PERMISSIONS in @roshd/types.
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Opaque refresh tokens (only the SHA-256 hash is stored). Tokens of one login share a familyId;
/// presenting a revoked token revokes the whole family (reuse detection, ADR-0002).
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────── Audit ───────────────────────────────────

/// Security and business events (not an error log). Append-only.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Service requests ──────────────────────────────

enum ServiceRequestType {
  FEASIBILITY
  RESEARCH
  CONSULTING
  TRAINING
  INVESTMENT
  CONTACT
}

enum ServiceRequestStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
}

/// Intake of every service enquiry from the public site (EPIC-11). Guests and users alike;
/// `userId` links the request when the submitter was signed in.
model ServiceRequest {
  id           String               @id @default(uuid(7)) @db.Uuid
  /// Human-friendly public reference (RA-XXXXXXXX), used with the mobile number for guest tracking.
  trackingCode String               @unique
  type         ServiceRequestType
  status       ServiceRequestStatus @default(NEW)
  userId       String?              @db.Uuid
  fullName     String
  mobile       String
  email        String?
  subject      String?
  message      String
  /// Type-specific fields (sector, stage, location, service, topic, reference).
  details      Json                 @default("{}")
  source       String               @default("web")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user   User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  events ServiceRequestStatusEvent[]

  @@index([userId, createdAt])
  @@index([type, status, createdAt])
  @@map("service_requests")
}

/// Status history (who changed what, when, with an optional staff note).
model ServiceRequestStatusEvent {
  id         String                @id @default(uuid(7)) @db.Uuid
  requestId  String                @db.Uuid
  fromStatus ServiceRequestStatus?
  toStatus   ServiceRequestStatus
  actorId    String?               @db.Uuid
  note       String?
  createdAt  DateTime              @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("service_request_status_events")
}

// ──────────────────────────────────── CMS ────────────────────────────────────

enum ContentKind {
  ARTICLE
  KNOWLEDGE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryScope {
  ARTICLE
  KNOWLEDGE
  RESEARCH
  COURSE
}

model Author {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  bio       String?
  /// Optional link to a platform account (editor/expert).
  userId    String?  @unique @db.Uuid
  createdAt DateTime @default(now())

  entries ContentEntry[]

  @@map("authors")
}

model Category {
  id        String        @id @default(uuid(7)) @db.Uuid
  scope     CategoryScope
  slug      String
  name      String
  createdAt DateTime      @default(now())

  entries ContentEntry[]

  @@unique([scope, slug])
  @@map("categories")
}

/// Articles and knowledge-base entries are distinct content kinds (separate APIs, routes,
/// sitemaps; ADR-0005) that share one editorial lifecycle and the same SEO fields.
model ContentEntry {
  id              String        @id @default(uuid(7)) @db.Uuid
  kind            ContentKind
  slug            String
  title           String
  excerpt         String?
  /// Markdown; rendered without raw HTML.
  body            String
  coverImageUrl   String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  authorId        String?       @db.Uuid
  categoryId      String?       @db.Uuid
  tags            String[]      @default([])
  /// Sources for reference content: [{ title, url? }]
  references      Json          @default("[]")
  // SEO
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  noIndex         Boolean       @default(false)
  ogImageUrl      String?
  /// Sample content (never presented as real).
  isDemo          Boolean       @default(false)
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([kind, slug])
  @@index([kind, status, publishedAt])
  @@map("content_entries")
}

/// Institutional pages with structured sections (moves copy out of the web content layer).
model Page {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  title           String
  /// [{ type, ...fields }] — rendered by typed web components.
  sections        Json          @default("[]")
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean       @default(false)
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pages")
}
