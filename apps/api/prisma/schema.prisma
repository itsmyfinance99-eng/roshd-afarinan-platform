// Roshd Afarinan platform — database schema (owned by apps/api).
// Every change requires a migration: pnpm --filter @roshd/api db:migrate:dev --name <change>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity & Access ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
}

/// One identity per person; capabilities come from roles (student, applicant, investor, ...).
model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  email             String     @unique
  mobile            String?    @unique
  fullName          String
  passwordHash      String
  status            UserStatus @default(ACTIVE)
  /// Reserved: MFA is designed but not yet implemented (ADR-0002).
  mfaEnabled        Boolean    @default(false)
  lastLoginAt       DateTime?
  /// Set when the user opens a verification link (or completes a password reset by email).
  emailVerifiedAt   DateTime?
  /// Access tokens issued before this instant are rejected (password change/reset, sign out everywhere, suspension).
  sessionsRevokedAt DateTime?
  /// Consecutive failed sign-ins since the last success or lock (per-account lockout).
  failedLoginCount  Int        @default(0)
  /// Sign-in is refused until this instant after too many failures.
  lockedUntil       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  roles                          UserRole[]                     @relation("UserRoles")
  assignedRoles                  UserRole[]                     @relation("RoleAssigner")
  refreshTokens                  RefreshToken[]
  passwordResets                 PasswordResetToken[]
  emailVerifications             EmailVerificationToken[]
  notifications                  Notification[]
  auditLogs                      AuditLog[]
  serviceRequests                ServiceRequest[]               @relation("ServiceRequestOwner")
  assignedRequests               ServiceRequest[]               @relation("ServiceRequestAssignee")
  files                          FileObject[]
  tickets                        Ticket[]                       @relation("TicketOwner")
  assignedTickets                Ticket[]                       @relation("TicketAssignee")
  orders                         Order[]
  assumptionTemplates            AssumptionTemplate[]           @relation("AssumptionTemplateOwner")
  financialModels                FinancialModel[]               @relation("FinancialModelOwner")
  assignedModels                 FinancialModel[]               @relation("FinancialModelAssignee")
  calculationRuns                CalculationRun[]               @relation("CalculationRunCreator")
  approvedRuns                   CalculationRun[]               @relation("CalculationRunApprover")
  feasibilityProjects            FeasibilityProject[]           @relation("FeasibilityProjectOwner")
  feasibilityEvents              FeasibilityStatusEvent[]
  expertAssignments              ExpertAssignment[]             @relation("ExpertAssignmentExpert")
  expertsAssigned                ExpertAssignment[]             @relation("ExpertAssignmentAssigner")
  expertsReleased                ExpertAssignment[]             @relation("ExpertAssignmentReleaser")
  questionnaireTemplatesCreated  QuestionnaireTemplate[]        @relation("QuestionnaireTemplateCreator")
  questionnaireVersionsPublished QuestionnaireTemplateVersion[] @relation("QuestionnaireVersionPublisher")
  questionnaireAnswersUpdated    QuestionnaireAnswer[]          @relation("QuestionnaireAnswerEditor")
  projectQuestionnaireItemsAdded ProjectQuestionnaireItem[]     @relation("ProjectQuestionnaireItemAuthor")
  projectDocumentsUploaded       ProjectDocument[]              @relation("ProjectDocumentUploader")
  feasibilityCostEstimates       FeasibilityCostEstimate[]      @relation("FeasibilityCostEstimateAuthor")
  feasibilityContractsUploaded   FeasibilityContract[]          @relation("FeasibilityContractUploader")
  feasibilityContractsConfirmed  FeasibilityContract[]          @relation("FeasibilityContractConfirmer")
  feasibilityInternalNotes       FeasibilityInternalNote[]      @relation("FeasibilityInternalNoteAuthor")
  feasibilityReviewThreads       FeasibilityReviewThread[]      @relation("FeasibilityReviewThreadStarter")
  feasibilityReportTemplates     FeasibilityReportTemplate[]    @relation("FeasibilityReportTemplateCreator")
  feasibilityReports             FeasibilityReport[]            @relation("FeasibilityReportCreator")
  feasibilityReportChapters      FeasibilityReportChapter[]     @relation("FeasibilityReportChapterEditor")
  feasibilityReportVersions      FeasibilityReportVersion[]     @relation("FeasibilityReportVersionIssuer")
  feasibilityReportApprovals     FeasibilityReportApproval[]    @relation("FeasibilityReportApprover")
  feasibilityReviewThreadsDone   FeasibilityReviewThread[]      @relation("FeasibilityReviewThreadHandler")
  feasibilityReviewComments      FeasibilityReviewComment[]     @relation("FeasibilityReviewCommentAuthor")

  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// Stable machine key, one of ROLES in @roshd/types.
  key         String  @unique
  name        String
  description String?

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// `resource:action`, one of PERMISSIONS in @roshd/types.
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId       String   @db.Uuid
  roleId       String   @db.Uuid
  assignedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Opaque refresh tokens (only the SHA-256 hash is stored). Tokens of one login share a familyId;
/// presenting a revoked token revokes the whole family (reuse detection, ADR-0002).
/// In-app notification of one user (dashboard notification center).
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// Event key, e.g. service_request.status_changed.
  kind      String
  title     String
  body      String?
  /// Site-relative dashboard path, set by the server only.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// One-time email verification link (only the SHA-256 of the token is stored).
model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_verification_tokens")
}

/// One-time password reset link (only the SHA-256 of the token is stored).
model PasswordResetToken {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  ip           String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────── Audit ───────────────────────────────────

/// Security and business events (not an error log). Append-only.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ───────────────────────────── Service requests ──────────────────────────────

enum ServiceRequestType {
  FEASIBILITY
  RESEARCH
  CONSULTING
  TRAINING
  INVESTMENT
  CONTACT
}

enum ServiceRequestStatus {
  NEW
  IN_REVIEW
  RESPONDED
  CLOSED
}

/// Intake of every service enquiry from the public site (EPIC-11). Guests and users alike;
/// `userId` links the request when the submitter was signed in.
model ServiceRequest {
  id           String               @id @default(uuid(7)) @db.Uuid
  /// Human-friendly public reference (RA-XXXXXXXX), used with the mobile number for guest tracking.
  trackingCode String               @unique
  type         ServiceRequestType
  status       ServiceRequestStatus @default(NEW)
  userId       String?              @db.Uuid
  fullName     String
  mobile       String
  email        String?
  subject      String?
  message      String
  /// Type-specific fields (sector, stage, location, service, topic, reference).
  details      Json                 @default("{}")
  source       String               @default("web")
  /// Staff member handling the request (holds requests:read-all when assigned).
  assigneeId   String?              @db.Uuid
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user     User?                       @relation("ServiceRequestOwner", fields: [userId], references: [id], onDelete: SetNull)
  assignee User?                       @relation("ServiceRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events   ServiceRequestStatusEvent[]
  /// The feasibility project this request was converted into (ST-35.02).
  project  FeasibilityProject?

  @@index([userId, createdAt])
  @@index([assigneeId, createdAt])
  @@index([type, status, createdAt])
  /// Staff list without filters, newest first (ST-26.07).
  @@index([createdAt])
  @@map("service_requests")
}

/// Status history (who changed what, when, with an optional staff note).
model ServiceRequestStatusEvent {
  id         String                @id @default(uuid(7)) @db.Uuid
  requestId  String                @db.Uuid
  fromStatus ServiceRequestStatus?
  toStatus   ServiceRequestStatus
  actorId    String?               @db.Uuid
  note       String?
  createdAt  DateTime              @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("service_request_status_events")
}

// ──────────────────────────────────── CMS ────────────────────────────────────

enum ContentKind {
  ARTICLE
  KNOWLEDGE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoryScope {
  ARTICLE
  KNOWLEDGE
  RESEARCH
  COURSE
}

model Author {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  bio       String?
  /// Optional link to a platform account (editor/expert).
  userId    String?  @unique @db.Uuid
  createdAt DateTime @default(now())

  entries ContentEntry[]

  @@map("authors")
}

model Category {
  id        String        @id @default(uuid(7)) @db.Uuid
  scope     CategoryScope
  slug      String
  name      String
  createdAt DateTime      @default(now())

  entries  ContentEntry[]
  courses  Course[]
  research ResearchProject[]

  @@unique([scope, slug])
  @@map("categories")
}

/// Articles and knowledge-base entries are distinct content kinds (separate APIs, routes,
/// sitemaps; ADR-0005) that share one editorial lifecycle and the same SEO fields.
model ContentEntry {
  id              String        @id @default(uuid(7)) @db.Uuid
  kind            ContentKind
  slug            String
  title           String
  excerpt         String?
  /// Markdown; rendered without raw HTML.
  body            String
  coverImageUrl   String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  authorId        String?       @db.Uuid
  categoryId      String?       @db.Uuid
  tags            String[]      @default([])
  /// Sources for reference content: [{ title, url? }]
  references      Json          @default("[]")
  // SEO
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  noIndex         Boolean       @default(false)
  ogImageUrl      String?
  /// Sample content (never presented as real).
  isDemo          Boolean       @default(false)
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([kind, slug])
  @@index([kind, status, publishedAt])
  @@map("content_entries")
}

/// Institutional pages with structured sections (moves copy out of the web content layer).
model Page {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  title           String
  /// [{ type, ...fields }] — rendered by typed web components.
  sections        Json          @default("[]")
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean       @default(false)
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pages")
}

// ───────────────────────────────── Learning ─────────────────────────────────
// Phase 1: public catalog only. LMS entities (lessons, enrollments, …) arrive in Phase 2.

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
  HYBRID
}

model Instructor {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  /// Short professional title, e.g. «کارشناس ارشد امکان‌سنجی».
  title     String?
  bio       String?
  /// Optional link to a platform account.
  userId    String?  @unique @db.Uuid
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  courses Course[]

  @@map("instructors")
}

model Course {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  title           String
  summary         String
  /// Markdown; rendered without raw HTML.
  description     String
  coverImageUrl   String?
  /// Category with scope COURSE (shared taxonomy owned by the CMS).
  categoryId      String?       @db.Uuid
  instructorId    String?       @db.Uuid
  level           CourseLevel
  deliveryMode    DeliveryMode
  durationHours   Int?
  isFree          Boolean       @default(false)
  /// Whole rials. Null on a paid course means "price on request" (no invented prices).
  priceRials      Decimal?      @db.Decimal(18, 0)
  startsAt        DateTime?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean       @default(false)
  /// Sample content (never presented as real).
  isDemo          Boolean       @default(false)
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructor Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("courses")
}

// ───────────────────────────────── Research ─────────────────────────────────

/// Public research portfolio (published studies and outputs). Research orders are ServiceRequests.
model ResearchProject {
  id              String        @id @default(uuid(7)) @db.Uuid
  slug            String        @unique
  title           String
  summary         String
  /// Markdown; rendered without raw HTML.
  body            String
  coverImageUrl   String?
  /// Category with scope RESEARCH (shared taxonomy owned by the CMS).
  categoryId      String?       @db.Uuid
  /// Solar Hijri year the study was completed (e.g. 1403), when known.
  year            Int?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean       @default(false)
  isDemo          Boolean       @default(false)
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("research_projects")
}

// ──────────────────────────────── Investment ────────────────────────────────
// Presentation only: no transactions, no returns, no "open for investment" claims.

enum InvestmentSector {
  MINING
  INDUSTRY
  ENERGY
  AGRI_FOOD
  SERVICES_INFRA
}

enum ProjectStage {
  IDEA
  MARKET_STUDY
  TECHNICAL_STUDY
  FEASIBILITY_STUDY
}

model InvestmentOpportunity {
  id                       String           @id @default(uuid(7)) @db.Uuid
  slug                     String           @unique
  title                    String
  summary                  String
  /// Markdown; rendered without raw HTML.
  description              String
  coverImageUrl            String?
  sector                   InvestmentSector
  stage                    ProjectStage
  province                 String?
  /// Service the project needs, e.g. «مطالعات امکان‌سنجی».
  serviceNeeded            String?
  /// Whole rials; only from approved project data (never estimated by the platform).
  estimatedInvestmentRials Decimal?         @db.Decimal(20, 0)
  status                   ContentStatus    @default(DRAFT)
  publishedAt              DateTime?
  metaTitle                String?
  metaDescription          String?
  noIndex                  Boolean          @default(false)
  isDemo                   Boolean          @default(false)
  createdById              String?          @db.Uuid
  updatedById              String?          @db.Uuid
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([status, sector, publishedAt])
  @@map("investment_opportunities")
}

// ──────────────────────────── Orders & Payments ────────────────────────────
// Status changes only through the order service; payment success only via server-side verify.

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum OrderItemKind {
  COURSE
}

enum PaymentAttemptStatus {
  INITIATED
  VERIFIED
  FAILED
}

model Order {
  id         String      @id @default(uuid(7)) @db.Uuid
  /// Human-readable code shown to the customer, e.g. OR-7K3M9QPD.
  code       String      @unique
  userId     String      @db.Uuid
  status     OrderStatus @default(PENDING_PAYMENT)
  /// Whole rials, computed on the server from item snapshots.
  totalRials Decimal     @db.Decimal(20, 0)
  paidAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  attempts PaymentAttempt[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @db.Uuid
  kind           OrderItemKind
  /// Id of the purchased record (e.g. Course.id); title and price are snapshots.
  referenceId    String        @db.Uuid
  referenceSlug  String
  title          String
  unitPriceRials Decimal       @db.Decimal(20, 0)
  quantity       Int           @default(1)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model PaymentAttempt {
  id                String               @id @default(uuid(7)) @db.Uuid
  orderId           String               @db.Uuid
  provider          String
  status            PaymentAttemptStatus @default(INITIATED)
  amountRials       Decimal              @db.Decimal(20, 0)
  idempotencyKey    String               @unique
  providerReference String?              @unique
  trackingCode      String?
  cardMask          String?
  failureReason     String?
  createdAt         DateTime             @default(now())
  completedAt       DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_attempts")
}

// ─────────────────────────────────── Files ───────────────────────────────────

enum FilePurpose {
  SERVICE_REQUEST_ATTACHMENT
  TICKET_ATTACHMENT
  USER_DOCUMENT
  /// Public media library image (CMS and catalog covers), served same-origin at /api/v1/media/:id.
  PUBLIC_IMAGE
  /// A document of a feasibility project (ST-35.06); read through the project only.
  FEASIBILITY_DOCUMENT
  /// A copy of the contract of a feasibility study (ST-35.09); read through the project only.
  FEASIBILITY_CONTRACT
  /// The PDF of a version of the report of a feasibility study (ST-35.13), written by the
  /// server; read through the project only.
  FEASIBILITY_REPORT
}

enum FileAccessLevel {
  PRIVATE
  PUBLIC
}

enum FileStatus {
  ACTIVE
  DELETED
}

/// Uploaded file metadata (roadmap §26, AI-ready metadata §14). Bytes live in the private
/// FileStorageProvider under `storageKey`; access only via authorization + signed URLs.
model FileObject {
  id           String          @id @default(uuid(7)) @db.Uuid
  ownerId      String          @db.Uuid
  purpose      FilePurpose
  /// Linked business entity (e.g. service_request + id), set when attached.
  entityType   String?
  entityId     String?
  accessLevel  FileAccessLevel @default(PRIVATE)
  originalName String
  mimeType     String
  size         Int
  /// SHA-256 hex of the content.
  checksum     String
  storageKey   String          @unique
  version      Int             @default(1)
  source       String          @default("upload")
  status       FileStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  deletedAt    DateTime?

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectDocument     ProjectDocument?
  feasibilityContract FeasibilityContract?
  reportFile          FeasibilityReportFile?

  @@index([ownerId, createdAt])
  @@index([entityType, entityId])
  @@index([purpose, status, createdAt])
  @@map("files")
}

// ────────────────────────────────── Tickets ──────────────────────────────────

enum TicketStatus {
  OPEN
  PENDING
  ANSWERED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum TicketCategory {
  GENERAL
  REQUEST
  TECHNICAL
  BILLING
}

/// Support conversation between a user and staff (EPIC-12). Optional link to a service request.
model Ticket {
  id               String         @id @default(uuid(7)) @db.Uuid
  /// Human-friendly reference, e.g. TK-7K3M9Q.
  code             String         @unique
  userId           String         @db.Uuid
  subject          String
  category         TicketCategory @default(GENERAL)
  priority         TicketPriority @default(NORMAL)
  status           TicketStatus   @default(OPEN)
  serviceRequestId String?        @db.Uuid
  /// Support agent handling the ticket (holds tickets:reply when assigned).
  assigneeId       String?        @db.Uuid
  lastMessageAt    DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user     User            @relation("TicketOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([userId, lastMessageAt])
  @@index([assigneeId, lastMessageAt])
  @@index([status, lastMessageAt])
  /// Staff list without a status filter, newest message first (ST-26.07).
  @@index([lastMessageAt])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String?  @db.Uuid
  /// True when written by staff (shown as «پشتیبانی» to the user).
  fromStaff Boolean  @default(false)
  /// Internal staff notes are never shown to the ticket owner.
  internal  Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ───────────────────────────── Financial model ─────────────────────────────

/// Personal set of assumptions (ST-34.01). Only its owner sees it; it is copied into a project on the
/// owner's request and never applied automatically. The platform ships no templates (no economic defaults).
model AssumptionTemplate {
  id          String   @id @default(uuid(7)) @db.Uuid
  ownerId     String   @db.Uuid
  name        String
  description String?
  /// Assumption[] validated by assumptionTemplateSchema (@roshd/validation): key, label, unit, value or
  /// per-period path, source, as-of date. Amounts are decimal strings.
  assumptions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation("AssumptionTemplateOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("assumption_templates")
}

/// Financial model of a project (ST-34.06, ADR-0009 §6): the user's inputs as a draft that may be
/// incomplete. Every save bumps `version`; calculations are stored as immutable runs.
model FinancialModel {
  id            String   @id @default(uuid(7)) @db.Uuid
  ownerId       String   @db.Uuid
  /// Expert working on the model (holds financial-models:work when assigned). Not used for the
  /// model of a feasibility project: there the experts of the project work on it (ST-35.10).
  assigneeId    String?  @db.Uuid
  title         String
  /// Draft inputs in the shape of the engine's ProjectInput (projectInputSchema in
  /// @roshd/validation checks them when a calculation is requested). Amounts are decimal strings.
  inputs        Json     @default("{}")
  /// Shape of `inputs` (FINANCIAL_MODEL_INPUT_VERSION).
  schemaVersion Int      @default(1)
  /// Incremented on every save; a save on top of an older version is refused.
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner    User                @relation("FinancialModelOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  assignee User?               @relation("FinancialModelAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  runs     CalculationRun[]
  /// The feasibility project this model belongs to, if any; such a model cannot be deleted and
  /// is reached only through the project (its staff and its assigned experts).
  project  FeasibilityProject?

  @@index([ownerId, updatedAt])
  @@index([assigneeId, updatedAt])
  @@index([updatedAt])
  @@map("financial_models")
}

/// One calculation of a financial model (ADR-0009 §6). Written once and never changed, except that
/// an expert may approve it once; a new calculation is a new run.
model CalculationRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  modelId       String    @db.Uuid
  /// Sequence within the model, from 1.
  number        Int
  /// `version` of the model the inputs were taken from.
  modelVersion  Int
  /// The validated inputs the engine received.
  input         Json
  /// SHA-256 of the canonical JSON of `input`.
  inputHash     String
  /// MODEL_VERSION of @roshd/financial-engine that produced the results.
  engineVersion String
  results       Json
  warnings      Json
  defaultsUsed  Json
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  approvedById  String?   @db.Uuid
  approvedAt    DateTime?

  model          FinancialModel             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  createdBy      User?                      @relation("CalculationRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?                      @relation("CalculationRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  /// The feasibility reports that take their figures from this run (ST-35.12).
  reports        FeasibilityReport[]        @relation("FeasibilityReportRun")
  reportVersions FeasibilityReportVersion[] @relation("FeasibilityReportVersionRun")

  @@unique([modelId, number])
  @@map("calculation_runs")
}

// ──────────────────────────────── Feasibility ────────────────────────────────
// ADR-0010. The status of a project changes only through the state machine of the feasibility
// module (`transition()`), which writes one status event per change.

enum FeasibilityStatus {
  DRAFT
  SUBMITTED
  INITIAL_REVIEW
  NEEDS_MORE_INFO
  COST_ESTIMATED
  CONTRACT_PENDING
  IN_PROGRESS
  EXPERT_REVIEW
  CLIENT_REVIEW
  DELIVERED
  ARCHIVED
}

/// In which capacity somebody changed the status of a project (FEASIBILITY_ACTORS in @roshd/validation).
enum FeasibilityActor {
  applicant
  staff
  expert
  system
}

/// A feasibility study from the applicant's draft to the delivered report (ST-35.01).
model FeasibilityProject {
  id                String            @id @default(uuid(7)) @db.Uuid
  /// Human-friendly reference, e.g. FP-7K3M9QPD.
  code              String            @unique
  /// The applicant.
  ownerId           String            @db.Uuid
  title             String
  /// One of FEASIBILITY_SECTORS (@roshd/validation), as on the request form of the public site.
  sector            String?
  location          String?
  summary           String?
  status            FeasibilityStatus @default(DRAFT)
  /// Since when the project is in its status (ST-35.15); written with every change of the status.
  statusSince       DateTime          @default(now())
  /// The financial model of the study (EPIC-34), made when the experts start working (ST-35.10).
  financialModelId  String?           @unique @db.Uuid
  /// The Phase 1 service request this project was converted from (ST-35.02).
  sourceRequestId   String?           @unique @db.Uuid
  /// The version of the questionnaire the project started with (ST-35.03); later versions of the
  /// template never change the questions of this project.
  templateVersionId String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner              User                          @relation("FeasibilityProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  templateVersion    QuestionnaireTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  answers            QuestionnaireAnswer[]
  questionnaireItems ProjectQuestionnaireItem[]
  documents          ProjectDocument[]
  financialModel     FinancialModel?               @relation(fields: [financialModelId], references: [id], onDelete: Restrict)
  sourceRequest      ServiceRequest?               @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)
  events             FeasibilityStatusEvent[]
  costEstimates      FeasibilityCostEstimate[]
  contracts          FeasibilityContract[]
  internalNotes      FeasibilityInternalNote[]
  reviewThreads      FeasibilityReviewThread[]
  report             FeasibilityReport?
  reportVersions     FeasibilityReportVersion[]
  experts            ExpertAssignment[]

  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
  @@index([status, statusSince])
  @@index([updatedAt])
  @@index([templateVersionId])
  @@map("feasibility_projects")
}

/// Status history of a project: one row per transition, written once (see the migration).
model FeasibilityStatusEvent {
  id         String             @id @default(uuid(7)) @db.Uuid
  projectId  String             @db.Uuid
  /// Null for the event that records the creation of the project.
  fromStatus FeasibilityStatus?
  toStatus   FeasibilityStatus
  actor      FeasibilityActor
  actorId    String?            @db.Uuid
  /// Message that goes with the transition; every party of the project reads it.
  note       String?
  createdAt  DateTime           @default(now())

  project   FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUser User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("feasibility_status_events")
}

/// What the staff estimate a study to cost and to take (ST-35.08). Entered by hand, never
/// computed; written once, together with the step to COST_ESTIMATED. The newest row of a
/// project is its estimate.
model FeasibilityCostEstimate {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @db.Uuid
  /// Whole rials.
  amountRials  Decimal  @db.Decimal(20, 0)
  /// What the study covers for this amount.
  scope        String
  durationDays Int
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())

  project   FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?              @relation("FeasibilityCostEstimateAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("feasibility_cost_estimates")
}

/// A copy of the signed contract of a study (ST-35.09), handed in by the applicant or by the
/// staff while the project waits for its contract. A copy is never overwritten: handing in
/// another one is the next version. The staff confirm one copy, and with it the work starts.
model FeasibilityContract {
  id            String           @id @default(uuid(7)) @db.Uuid
  projectId     String           @db.Uuid
  version       Int
  fileId        String           @unique @db.Uuid
  uploadedById  String?          @db.Uuid
  /// In which capacity it was handed in: `applicant` or `staff`.
  uploadedAs    FeasibilityActor
  createdAt     DateTime         @default(now())
  /// Set once, together with the step to IN_PROGRESS: the copy the staff confirmed.
  confirmedAt   DateTime?
  confirmedById String?          @db.Uuid

  project     FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file        FileObject         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy  User?              @relation("FeasibilityContractUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  confirmedBy User?              @relation("FeasibilityContractConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([projectId, version])
  @@map("feasibility_contracts")
}

/// A note the staff and the experts of a project write for each other (ST-35.10). The applicant
/// never reads it. Written once: a correction is another note.
model FeasibilityInternalNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  createdAt DateTime @default(now())

  project FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?              @relation("FeasibilityInternalNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@map("feasibility_internal_notes")
}

/// A thread of comments on one part of a study (ST-35.11), started in its review by the
/// applicant, the staff or an expert. The comments are in `feasibility_review_comments`; the
/// first one is written together with the thread.
model FeasibilityReviewThread {
  id          String    @id @default(uuid(7)) @db.Uuid
  projectId   String    @db.Uuid
  /// One of FEASIBILITY_REVIEW_SECTIONS (@roshd/validation).
  section     String
  /// Whether the applicant reads the thread. Always true for a thread of the applicant; a
  /// thread of the staff or of an expert is between them unless they share it. Never changed.
  shared      Boolean
  startedById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  /// Set while the thread counts as handled; null again when it is opened once more.
  handledAt   DateTime?
  handledById String?   @db.Uuid

  project   FeasibilityProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startedBy User?                      @relation("FeasibilityReviewThreadStarter", fields: [startedById], references: [id], onDelete: SetNull)
  handledBy User?                      @relation("FeasibilityReviewThreadHandler", fields: [handledById], references: [id], onDelete: SetNull)
  comments  FeasibilityReviewComment[]

  @@index([projectId, createdAt])
  @@map("feasibility_review_threads")
}

/// One comment of a review thread. Written once: a correction is another comment.
model FeasibilityReviewComment {
  id        String           @id @default(uuid(7)) @db.Uuid
  threadId  String           @db.Uuid
  authorId  String?          @db.Uuid
  /// In which capacity it was written: `applicant`, `staff` or `expert`.
  authorAs  FeasibilityActor
  body      String
  createdAt DateTime         @default(now())

  thread FeasibilityReviewThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?                   @relation("FeasibilityReviewCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("feasibility_review_comments")
}

/// The chapters a feasibility report is made of, as the staff arranged them (ST-35.12, OQ-35).
/// A report copies the chapters when it takes the template, so a later change of the template
/// never changes a report that was started.
model FeasibilityReportTemplate {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  /// reportStructureSchema of @roshd/validation: chapters in their order with title and guidance.
  chapters    Json
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// An archived template is not offered to new reports.
  archivedAt  DateTime?

  createdBy User?               @relation("FeasibilityReportTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reports   FeasibilityReport[]

  @@index([archivedAt, name])
  @@map("feasibility_report_templates")
}

/// The draft of the report of a study (ST-35.12): its chapters are in
/// `feasibility_report_chapters`. The experts and the staff of the project edit it while the
/// study is worked on; what is handed on is a version (`feasibility_report_versions`).
model FeasibilityReport {
  id               String   @id @default(uuid(7)) @db.Uuid
  projectId        String   @unique @db.Uuid
  /// The template the chapters were taken from; null for the standard structure.
  templateId       String?  @db.Uuid
  /// The approved calculation run of the project's financial model the report takes its
  /// financial and economic chapters from.
  calculationRunId String?  @db.Uuid
  createdById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        FeasibilityProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template       FeasibilityReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  calculationRun CalculationRun?            @relation("FeasibilityReportRun", fields: [calculationRunId], references: [id], onDelete: Restrict)
  createdBy      User?                      @relation("FeasibilityReportCreator", fields: [createdById], references: [id], onDelete: SetNull)
  chapters       FeasibilityReportChapter[]

  @@index([calculationRunId])
  @@map("feasibility_reports")
}

/// One chapter of the draft of a report. A chapter that is not in the structure any more
/// (`included` false) keeps its text, in case the structure takes it back.
model FeasibilityReportChapter {
  id          String   @id @default(uuid(7)) @db.Uuid
  reportId    String   @db.Uuid
  /// One of FEASIBILITY_REPORT_CHAPTERS (@roshd/validation).
  key         String
  position    Int
  included    Boolean  @default(true)
  title       String
  guidance    String?
  /// Markdown.
  body        String   @default("")
  /// Keys of the questions of the project's questionnaire whose answers the chapter quotes.
  answerKeys  Json     @default("[]")
  /// Incremented on every save; a save on top of an older version is refused.
  version     Int      @default(1)
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt

  report    FeasibilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation("FeasibilityReportChapterEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([reportId, key])
  @@map("feasibility_report_chapters")
}

/// A version of the report as it was issued (ST-35.12): written once and never changed or
/// deleted (see the migration). `content` holds the chapters with their text and the quoted
/// answers as they were; the figures are those of the calculation run, which never changes.
model FeasibilityReportVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  projectId        String   @db.Uuid
  /// Sequence within the project, from 1.
  number           Int
  content          Json
  /// SHA-256 of the canonical JSON of `content`.
  contentHash      String
  calculationRunId String?  @db.Uuid
  /// What changed in this version, for those who work on the study.
  note             String?
  issuedById       String?  @db.Uuid
  createdAt        DateTime @default(now())

  project        FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  calculationRun CalculationRun?    @relation("FeasibilityReportVersionRun", fields: [calculationRunId], references: [id], onDelete: Restrict)
  issuedBy       User?              @relation("FeasibilityReportVersionIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  file           FeasibilityReportFile?
  approvals      FeasibilityReportApproval[]

  @@unique([projectId, number])
  @@index([calculationRunId])
  @@map("feasibility_report_versions")
}

/// The PDF of a version of a report (ST-35.13): written once, from the version and its
/// calculation run, and kept as a private file. Its hash is that of the bytes of the file.
model FeasibilityReportFile {
  id        String   @id @default(uuid(7)) @db.Uuid
  versionId String   @unique @db.Uuid
  fileId    String   @unique @db.Uuid
  /// SHA-256 (hex) of the bytes of the file.
  sha256    String
  size      Int
  /// The display unit of the amounts in local currency the file was written with.
  unit      String
  /// How many approvals of the version the file shows; a file that shows fewer than the
  /// version has is written again (ST-35.14).
  approvals Int      @default(0)
  createdAt DateTime @default(now())

  version FeasibilityReportVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  file    FileObject               @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("feasibility_report_files")
}

enum ReportApprovalStep {
  OFFICER
  ADMIN
}

enum ReportApprovalDecision {
  APPROVED
  REJECTED
}

/// A decision on a version of a report (ST-35.14, OQ-37): the approval of the feasibility
/// officer, then that of an admin, or a refusal at either step. Written once, one per step.
model FeasibilityReportApproval {
  id            String                 @id @default(uuid(7)) @db.Uuid
  versionId     String                 @db.Uuid
  step          ReportApprovalStep
  decision      ReportApprovalDecision
  /// Why the version was refused, or a remark; for those who work on the study.
  note          String?
  decidedById   String?                @db.Uuid
  /// The name of who decided, as it was then: it stands on the report.
  decidedByName String
  createdAt     DateTime               @default(now())

  version   FeasibilityReportVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  decidedBy User?                    @relation("FeasibilityReportApprover", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([versionId, step])
  @@map("feasibility_report_approvals")
}

enum QuestionnaireVersionStatus {
  DRAFT
  PUBLISHED
}

/// Where a project-specific item of a questionnaire came from (OQ-36).
enum QuestionnaireItemOrigin {
  applicant
  staff
}

enum QuestionnaireItemKind {
  QUESTION
  DOCUMENT
  NOTE
}

/// A questionnaire of the feasibility platform (ST-35.03, ADR-0010 §4): data, not code. Its
/// content lives in its versions.
model QuestionnaireTemplate {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  /// One of FEASIBILITY_SECTORS, or null for the general questionnaire of every sector.
  sector      String?
  /// Sample content until the real questionnaires arrive; shown with «نمونه نمایشی».
  isDemo      Boolean   @default(false)
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// An archived template is not offered to new projects; projects that started with it keep it.
  archivedAt  DateTime?

  createdBy User?                          @relation("QuestionnaireTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions  QuestionnaireTemplateVersion[]

  @@index([sector, archivedAt])
  @@map("questionnaire_templates")
}

/// One version of a template. A draft is edited freely; a published version never changes
/// (see the migration), because projects are pinned to it.
model QuestionnaireTemplateVersion {
  id            String                     @id @default(uuid(7)) @db.Uuid
  templateId    String                     @db.Uuid
  version       Int
  status        QuestionnaireVersionStatus @default(DRAFT)
  /// questionnaireDefinitionSchema of @roshd/validation: sections, questions, documents.
  definition    Json
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  publishedAt   DateTime?
  publishedById String?                    @db.Uuid

  template    QuestionnaireTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  publishedBy User?                 @relation("QuestionnaireVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  projects    FeasibilityProject[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("questionnaire_template_versions")
}

/// The answer of a project to one question, of the pinned version or of the project's own
/// items; stored in the form validateAnswer() of @roshd/validation returns.
model QuestionnaireAnswer {
  id          String   @id @default(uuid(7)) @db.Uuid
  projectId   String   @db.Uuid
  questionKey String
  value       Json
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy User?              @relation("QuestionnaireAnswerEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([projectId, questionKey])
  @@map("questionnaire_answers")
}

/// A question, a document to hand in or a note that belongs to one project only (OQ-36), added
/// by the applicant or by staff; the origin is kept with it.
model ProjectQuestionnaireItem {
  id         String                  @id @default(uuid(7)) @db.Uuid
  projectId  String                  @db.Uuid
  kind       QuestionnaireItemKind
  /// Unique in the project, and never the key of a question of the pinned version.
  key        String
  /// A question (questionSchema), a document (requiredDocumentSchema) or `{ text }` for a note.
  definition Json
  origin     QuestionnaireItemOrigin
  addedById  String?                 @db.Uuid
  createdAt  DateTime                @default(now())

  project FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy User?              @relation("ProjectQuestionnaireItemAuthor", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([projectId, key])
  @@index([projectId, createdAt])
  @@map("project_questionnaire_items")
}

/// What a file of a project was handed in for.
enum ProjectDocumentKind {
  /// A document of the list: of the pinned template, or one the project has of its own.
  DOCUMENT
  /// A file given as the answer to a file question.
  ANSWER
}

/// One file handed in for a document or a file question of a project (ST-35.06). A document is
/// never overwritten: handing it in again is its next version, and the earlier ones stay.
model ProjectDocument {
  id           String              @id @default(uuid(7)) @db.Uuid
  projectId    String              @db.Uuid
  kind         ProjectDocumentKind
  /// The key of the document or of the file question it belongs to.
  slotKey      String
  version      Int
  fileId       String              @unique @db.Uuid
  uploadedById String?             @db.Uuid
  createdAt    DateTime            @default(now())

  project    FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file       FileObject         @relation(fields: [fileId], references: [id], onDelete: Restrict)
  uploadedBy User?              @relation("ProjectDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([projectId, kind, slotKey, version])
  @@map("project_documents")
}

/// An expert working on a project. The assignment is active while `endedAt` is null; ending it
/// keeps the row as history, and a later assignment of the same expert is a new row.
model ExpertAssignment {
  id           String    @id @default(uuid(7)) @db.Uuid
  projectId    String    @db.Uuid
  expertId     String    @db.Uuid
  assignedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  endedAt      DateTime?
  endedById    String?   @db.Uuid

  project    FeasibilityProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expert     User               @relation("ExpertAssignmentExpert", fields: [expertId], references: [id], onDelete: Restrict)
  assignedBy User?              @relation("ExpertAssignmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  endedBy    User?              @relation("ExpertAssignmentReleaser", fields: [endedById], references: [id], onDelete: SetNull)

  @@index([projectId, endedAt])
  @@index([expertId, endedAt])
  @@map("expert_assignments")
}
