{
  "name": "@roshd/api",
  "version": "0.0.0",
  "private": true,
  "description": "Roshd Afarinan platform API (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --builder swc",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@roshd/types": "workspace:*",
    "@roshd/validation": "workspace:*",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.6",
    "@roshd/eslint-config": "workspace:*",
    "@roshd/tsconfig": "workspace:*",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
