{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_INTERNAL_URL"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DEV_ALLOWED_ORIGINS"]
    },
    "lint": {
      "dependsOn": ["^build", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL", "JWT_ACCESS_SECRET", "FILE_URL_SECRET"]
    },
    "generate": {
      "outputs": ["src/generated/**"],
      "inputs": ["prisma/schema.prisma"]
    }
  }
}
