# Copy to `.env` for local development (git-ignored). Never commit real secrets.
# Every variable is validated at boot; see apps/api/src/config/env.schema.ts.

# ── API ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated origins for non-web clients (web uses same-origin rewrites)
CORS_ORIGINS=
# Number of trusted reverse proxies in front of the API (1 behind nginx)
TRUST_PROXY=0
# Defaults to true outside production
SWAGGER_ENABLED=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
