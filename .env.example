# Copy to `.env` for local development (git-ignored). Never commit real secrets.
# Every variable is validated at boot; see apps/api/src/config/env.schema.ts.

# ── API ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated origins for non-web clients (web uses same-origin rewrites)
CORS_ORIGINS=
# Number of trusted reverse proxies in front of the API: 1 behind nginx (infra/nginx/README.md).
# 0 only for local development without a proxy.
# Hop count (1 behind nginx) or, safer, the trusted proxy addresses: TRUST_PROXY=loopback,172.16.0.0/12
TRUST_PROXY=0
# Swagger UI at /docs. Defaults to true outside production; true in production publishes the
# API surface and is meant only for a demo server (see docs/security/security-baseline.md).
SWAGGER_ENABLED=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── Database (docker compose: see docker-compose.yml) ─────────────────
# Connection pool and timeouts (a stalled database must fail fast, not hang; ST-26.05)
DATABASE_POOL_SIZE=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
DATABASE_URL=postgresql://roshd:roshd_dev_password@127.0.0.1:5433/roshd
# Used only by e2e tests; the database name MUST end with _test (it is reset on every run)
TEST_DATABASE_URL=postgresql://roshd:roshd_dev_password@127.0.0.1:5433/roshd_test

# ── Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48   (≥ 32 chars; different per environment)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Lifetime of password reset links in minutes (5-120)
PASSWORD_RESET_TTL_MINUTES=30
# Lifetime of email verification links (hours)
EMAIL_VERIFICATION_TTL_HOURS=48
# Marks the session cookies Secure. Defaults to true in production; false there sends them over
# plain http and the API warns at boot — for local or demo testing only.
COOKIE_SECURE=
COOKIE_DOMAIN=
AUTH_THROTTLE_LIMIT=5
# Per-account lockout: after this many consecutive wrong passwords, sign-in is refused for LOGIN_LOCK_MINUTES
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ── Providers (ADR-0004) ───────────────────────────────────────────────
# disabled | mock  (default: mock in development, disabled in production; mock is refused in production)
# Public origin of the web app; payment callbacks and post-payment redirects use it
WEB_BASE_URL=http://localhost:3000
# Shared secret (>= 32 chars) sent by the web server on server-side reads so rendering is not
# rate-limited as one visitor. Set the same value for the API and the web app.
INTERNAL_API_TOKEN=
PAYMENT_PROVIDER=
STORAGE_DRIVER=local
# Private upload directory (relative to apps/api), never web-served
STORAGE_LOCAL_DIR=storage
NOTIFICATION_DRIVER=log
# Error reporting for 5xx responses and crashes (log = structured error lines; see docs/operations/monitoring.md)
ERROR_REPORTER_DRIVER=log
# HMAC secret for signed, expiring file-download URLs (≥ 32 chars; openssl rand -base64 48)
FILE_URL_SECRET=
SIGNED_URL_TTL_SECONDS=300
# Per-user ceiling on uploads not yet attached to a request or ticket, and how long they are kept
UPLOAD_QUOTA_BYTES=209715200
UPLOAD_QUOTA_FILES=50
UPLOAD_RETENTION_HOURS=72
# Data retention in days (0 disables the job). Spent refresh, reset and verification tokens are
# deleted after TOKEN_RETENTION_DAYS; notifications the user already read after the second value.
TOKEN_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=180

# ── Seed (development) ─────────────────────────────────────────────────
# Creates the first super_admin when both are set (password ≥ 12 chars). Leave empty elsewhere.
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=
# Development only: `pnpm --filter @roshd/api db:seed:demo` creates one sample account per role
# (<role>@demo.roshd.test, e.g. admin@demo.roshd.test) with this password (≥ 12 chars) when it is
# set. Leave empty elsewhere; the demo seed refuses to run in production.
SEED_DEMO_PASSWORD=

# ── Web (apps/web) ─────────────────────────────────────────────────────
# Public base URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the "prototype · demo data" notice in the header (set false once real content is live)
NEXT_PUBLIC_DEMO_MODE=true
# Where the web server proxies /api/* and where server components call the API
API_INTERNAL_URL=http://127.0.0.1:4000
# Serve the payment simulator page (/mock-gateway) from a production build: demo/test only, never live
ENABLE_MOCK_GATEWAY=
